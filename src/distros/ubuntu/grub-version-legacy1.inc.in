
   # Ubuntu Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)
   iperd_distro_opt_desc distro_ver_opt "@DISTRO_VER_OPT@";
   submenu "Ubuntu Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@) [${distro_ver_opt}] ..." {
      @DISTRO_VER_METADATA@

      menuentry 'Install' {
         iperd_distro_ver_metadata \
                'Ubuntu Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading linux ...'
         linux  ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/linux \
                quiet \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.gz ...'
         initrd ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/initrd.gz
         echo   'booting system ...'
      }
      menuentry 'Expert Install' {
         iperd_distro_ver_metadata \
                'Ubuntu Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading linux ...'
         linux  ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/linux \
                priority=low \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.gz ...'
         initrd ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/initrd.gz
         echo   'booting system ...'
      }
      menuentry 'Rescue Mode' {
         iperd_distro_ver_metadata \
                'Ubuntu Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading linux ...'
         linux  ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/linux \
                rescue/enable=true quiet \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.gz ...'
         initrd ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/initrd.gz
         echo   'booting system ...'
      }
      menuentry 'Automated Install' {
         iperd_distro_ver_metadata \
                'Ubuntu Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading linux ...'
         linux  ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/linux \
                auto=true priority=critical quiet \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.gz ...'
         initrd ${distro_ver_grub}/netboot/ubuntu-installer/@DISTRO_VER_ARCH@/initrd.gz
         echo   'booting system ...'
      }
   }

