
#
# Ubuntu Linux @DISTRO_VERSION@ (amd64)
#
DISTRO_UBUNTU_@DISTRO_CODENAME@_AMD64		?= n
ifneq ($(DISTRO_UBUNTU_@DISTRO_CODENAME@_AMD64), n)
   DISTRO_UBUNTU_CFG		+= build/distros/ubuntu/ubuntu-@DISTRO_VERSION@-amd64.inc
endif
ifeq ($(DISTRO_UBUNTU_@DISTRO_CODENAME@_AMD64), d)
   DISTRO_UBUNTU_BOOT		+= boot/ubuntu/dists/@DISTRO_VERSION@/main/installer-amd64/current/legacy-images/.iperd
else ifneq ($(DISTRO_UBUNTU_@DISTRO_CODENAME@_AMD64), l)
   DISTRO_UBUNTU_@DISTRO_CODENAME@_AMD64	:= y
endif


build/distros/ubuntu/ubuntu-@DISTRO_VERSION@-amd64.inc: src/distros/ubuntu/grub-distro-legacy2.inc.in .config
	@$(DISTRO_UBUNTU_KEYWORDS) \
		DISTRO_VERSION=@DISTRO_VERSION@; \
		DISTRO_OPT=$(DISTRO_UBUNTU_@DISTRO_CODENAME@_AMD64); \
		DISTRO_VER_ARCH=amd64; \
		$(do_subst_file_dt)

