
#
# Slackware Linux @DISTRO_VERSION@ (x86)
#
DISTRO_SLACKWARE_@DISTRO_TAG@		?= n
ifneq ($(DISTRO_SLACKWARE_@DISTRO_TAG@), n)
   DISTRO_SLACKWARE_CFG		+= build/distros/slackware/slackware-@DISTRO_VERSION@.inc
endif
ifeq ($(DISTRO_SLACKWARE_@DISTRO_TAG@), d)
   DISTRO_SLACKWARE_BOOT	+= boot/slackware/slackware-@DISTRO_VERSION@/isolinux/initrd.img
   DISTRO_SLACKWARE_BOOT	+= boot/slackware/slackware-@DISTRO_VERSION@/kernels/huge.s/bzImage
else ifneq ($(DISTRO_SLACKWARE_@DISTRO_TAG@), l)
   DISTRO_SLACKWARE_@DISTRO_TAG@		:= y
endif


build/distros/slackware/slackware-@DISTRO_VERSION@.inc.in: src/distros/slackware/grub-version.inc.in src/cfg/grub-distro-keywords.cfg.in
	@SED_FILE="$(<)"; \
		SED_INCLUDE="src/cfg/grub-distro-keywords.cfg.in"; \
		SED_KEYWORD="[@]DISTRO_VER_METADATA[@]"; \
		$(do_include);


build/distros/slackware/slackware-@DISTRO_VERSION@.inc: build/distros/slackware/slackware-@DISTRO_VERSION@.inc.in .config
	@$(DISTRO_SLACKWARE_KEYWORDS) \
		DISTRO_VERSION=@DISTRO_VERSION@; \
		DISTRO_VER_OPT=$(DISTRO_SLACKWARE_@DISTRO_TAG@); \
		DISTRO_VER_ARCH=x86; \
		DISTRO_VER_PATH='/slackware-@DISTRO_VERSION@'; \
		$(do_subst_file_dt)


#
# Slackware Linux @DISTRO_VERSION@ (x86_64)
#
DISTRO_SLACKWARE64_@DISTRO_TAG@		?= n
ifneq ($(DISTRO_SLACKWARE64_@DISTRO_TAG@), n)
   DISTRO_SLACKWARE_CFG		+= build/distros/slackware/slackware64-@DISTRO_VERSION@.inc
endif
ifeq ($(DISTRO_SLACKWARE64_@DISTRO_TAG@), d)
   DISTRO_SLACKWARE_BOOT	+= boot/slackware/slackware64-@DISTRO_VERSION@/isolinux/initrd.img
   DISTRO_SLACKWARE_BOOT	+= boot/slackware/slackware64-@DISTRO_VERSION@/kernels/huge.s/bzImage
else ifneq ($(DISTRO_SLACKWARE64_@DISTRO_TAG@), l)
   DISTRO_SLACKWARE64_@DISTRO_TAG@	:= y
endif


build/distros/slackware/slackware64-@DISTRO_VERSION@.inc.in: src/distros/slackware/grub-version.inc.in src/cfg/grub-distro-keywords.cfg.in
	@SED_FILE="$(<)"; \
		SED_INCLUDE="src/cfg/grub-distro-keywords.cfg.in"; \
		SED_KEYWORD="[@]DISTRO_VER_METADATA[@]"; \
		$(do_include);


build/distros/slackware/slackware64-@DISTRO_VERSION@.inc: build/distros/slackware/slackware64-@DISTRO_VERSION@.inc.in .config
	@$(DISTRO_SLACKWARE_KEYWORDS) \
		DISTRO_VERSION=@DISTRO_VERSION@; \
		DISTRO_VER_OPT=$(DISTRO_SLACKWARE64_@DISTRO_TAG@); \
		DISTRO_VER_ARCH=x86_64; \
		DISTRO_VER_PATH='/slackware64-@DISTRO_VERSION@'; \
		$(do_subst_file_dt)

