
   # Slackware Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)
   iperd_distro_opt_desc distro_ver_opt "@DISTRO_VER_OPT@";
   menuentry "Slackware Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@) [${distro_ver_opt}]" {
      @DISTRO_VER_METADATA@

      iperd_distro_ver_metadata \
             'Slackware Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
             '@DISTRO_VER_OPT@';

      echo   'loading bzImage ...'
      linux  ${distro_ver_grub}/kernels/huge.s/bzImage \
             load_ramdisk=1 prompt_ramdisk=0 rw printk.time=0  nomodeset \
             SLACK_KERNEL=huge.s console=${iperd_linux_console} \
             ${distro_ver_append}
      echo   'loading initrd ...'
      initrd ${distro_ver_grub}/isolinux/initrd.img
      echo   'booting system ...'
   }

