   menuentry "Slackware Linux @DISTRO_VERSION@ (@DISTRO_ARCH@)" {
      echo   'Slackware Linux @DISTRO_VERSION@ (@DISTRO_ARCH@)'
      echo   'Loading bzImage ...'
      linux  ${slackware_prefix}/slackware@DISTRO_SUFFIX@-@DISTRO_VERSION@/kernels/hugesmp.s/bzImage \
             load_ramdisk=1 prompt_ramdisk=0 rw printk.time=0  nomodeset \
             SLACK_KERNEL=hugesmp.s console=${iperd_console} \
             ${slackware_append}
      echo   'Loading initrd ...'
      initrd initrd ${slackware_prefix}/slackware@DISTRO_SUFFIX@-@DISTRO_VERSION@/isolinux/initrd.img
      echo   'booting system ...'
   }
