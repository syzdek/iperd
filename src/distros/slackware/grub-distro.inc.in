
   set distro_ver_opt="@DISTRO_OPT@";
   iperd_distro_ver_desc
   menuentry "Slackware Linux @DISTRO_VERSION@ (@DISTRO_ARCH@) [${distro_ver_loc}]" {
      if [ "@DISTRO_OPT@x" == "dx" ]; then
         set distro_ver_grub="${iperd_grub}/boot/slackware/slackware@DISTRO_SUFFIX@-@DISTRO_VERSION@"
      elif [ "@DISTRO_OPT@x" == "lx" ]; then
         set distro_ver_grub="@DISTRO_LOCAL_GRUB@/slackware@DISTRO_SUFFIX@-@DISTRO_VERSION@"
      else
         set distro_ver_grub="@DISTRO_GRUB@/slackware@DISTRO_SUFFIX@-@DISTRO_VERSION@"
      fi
      export distro_ver_grub
      echo   'Slackware Linux @DISTRO_VERSION@ (@DISTRO_ARCH@)'
      echo   "${distro_ver_loc}: ${distro_ver_grub}"
      echo   'Loading bzImage ...'
      linux  ${distro_ver_grub}/kernels/huge.s/bzImage \
             load_ramdisk=1 prompt_ramdisk=0 rw printk.time=0  nomodeset \
             SLACK_KERNEL=huge.s console=${iperd_console} \
             ${distro_append}
      echo   'Loading initrd ...'
      initrd ${distro_ver_grub}/isolinux/initrd.img
      echo   'booting system ...'
   }
