
#
# Rocky Linux @DISTRO_VERSION@
#
DISTRO_ROCKY_@DISTRO_VERSION@			?= n
ifneq ($(DISTRO_ROCKY_@DISTRO_VERSION@), n)
   DISTRO_ROCKY_CFG		+= build/distros/rocky/rocky-@DISTRO_VERSION@.inc
endif
ifeq ($(DISTRO_ROCKY_@DISTRO_VERSION@), d)
   DISTRO_ROCKY_BOOT		+= boot/rocky/@DISTRO_VERSION@/BaseOS/x86_64/os/images/pxeboot/initrd.img
   DISTRO_ROCKY_BOOT		+= boot/rocky/@DISTRO_VERSION@/BaseOS/x86_64/os/images/pxeboot/vmlinuz
else ifneq ($(DISTRO_ROCKY_@DISTRO_VERSION@), l)
   DISTRO_ROCKY_@DISTRO_VERSION@		:= y
endif


build/distros/rocky/rocky-@DISTRO_VERSION@.inc.in: src/distros/rocky/grub-distro.inc.in src/cfg/grub-distro-keywords.cfg.in
	@SED_FILE="$(<)"; \
		SED_INCLUDE="src/cfg/grub-distro-keywords.cfg.in"; \
		SED_KEYWORD="[@]DISTRO_VER_METADATA[@]"; \
		$(do_include);


build/distros/rocky/rocky-@DISTRO_VERSION@.inc: build/distros/rocky/rocky-@DISTRO_VERSION@.inc.in .config
	@$(DISTRO_ROCKY_KEYWORDS) \
		DISTRO_VERSION=@DISTRO_VERSION@; \
		DISTRO_VER_OPT=$(DISTRO_ROCKY_@DISTRO_VERSION@); \
		DISTRO_VER_ARCH=x86_64; \
		DISTRO_VER_PATH='/@DISTRO_VERSION@/BaseOS/x86_64'; \
		$(do_subst_file_dt)

