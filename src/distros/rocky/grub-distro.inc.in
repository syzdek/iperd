
   iperd_distro_opt_desc distro_ver_opt "@DISTRO_VER_OPT@";
   submenu "Rocky Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@) [${distro_ver_opt}] ..." {

      @DISTRO_VER_METADATA@

      menuentry "Install or upgrade an existing system" {
         iperd_distro_ver_metadata \
                'Rocky Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Install system with basic video driver" {
         iperd_distro_ver_metadata \
                'Rocky Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                nomodeset \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Install system from kickstart over network" {
         iperd_distro_ver_metadata \
                'Rocky Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                nomodeset ramdisk_size=100000 net.ifnames=0 \
                inst.repo=${distro_ver_repo}/os/ \
                inst.stage2=${distro_ver_repo}/kickstart \
                inst.ks=@DISTRO_EXTRA_URL@ \
                inst.text \
                ip=eth0:dhcp \
                console=${iperd_linux_console} \
                ${distro_ver_append} @DISTRO_EXTRA_APPEND@
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Install system from network" {
         iperd_distro_ver_metadata \
                'Rocky Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                nomodeset ramdisk_size=100000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_repo}/os/ \
                inst.stage2=${distro_ver_repo}/os \
                inst.text \
                ip=eth0:dhcp \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Rescue installed system" {
         iperd_distro_ver_metadata \
                'Rocky Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                rescue \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
   }
