
   set distro_ver_opt="@DISTRO_OPT@";
   iperd_distro_ver_desc
   menuentry "Alpine Linux @DISTRO_VERSION@ Installers (@DISTRO_VER_ARCH@) [${distro_ver_loc}]" {

      set distro_name="alpine";
      set distro_ver_opt="@DISTRO_OPT@";
      set distro_local_grub="@DISTRO_LOCAL_GRUB@";
      set distro_local_url="@DISTRO_LOCAL_URL@";
      set distro_grub="@DISTRO_GRUB@";
      set distro_url="@DISTRO_URL@";

      iperd_distro_ver_paths;

      set distro_ver_suffix="v@DISTRO_VERSION@";
      set distro_ver_grub="${distro_ver_grub}/${distro_ver_suffix}";
      set distro_ver_url="${distro_ver_url}/${distro_ver_suffix}";

      export distro_ver_grub;
      export distro_ver_url;
      export distro_ver_append;
      export distro_ver_loc;

      set iperd_verbose_str='Alpine Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)'
      export iperd_verbose_str

      iperd_print_distro_verbose
      echo   'loading vmlinuz-lts ...'
      linux  ${distro_ver_grub}/releases/@DISTRO_VER_ARCH@/netboot/vmlinuz-lts \
             modloop=${distro_ver_url}/releases/@DISTRO_VER_ARCH@/netboot/modloop-lts \
             modules=loop,squashfs,sd-mod,usb-storage \
             alpine_repo=${distro_ver_url}/main \
             ip=dhcp:::::eth0: \
             console=${iperd_linux_console} \
             ${distro_ver_append}
      echo   'loading initramfs-lts ...'
      initrd ${distro_ver_grub}/releases/@DISTRO_VER_ARCH@/netboot/initramfs-lts
      echo   'booting system ...'
   }
