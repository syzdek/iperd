
#
# Alpine Linux @DISTRO_VERSION@ (x86)
#
DISTRO_ALPINE_@DISTRO_TAG@_x86		?= n
ifneq ($(DISTRO_ALPINE_@DISTRO_TAG@_x86), n)
   DISTRO_ALPINE_CFG		+= build/distros/alpine/alpine-@DISTRO_VERSION@-x86.inc
endif
ifeq ($(DISTRO_ALPINE_@DISTRO_TAG@_x86), d)
   DISTRO_ALPINE_BOOT		+= boot/alpine/v@DISTRO_VERSION@/main/x86/.iperd
else ifneq ($(DISTRO_ALPINE_@DISTRO_TAG@_x86), l)
   DISTRO_ALPINE_@DISTRO_TAG@_x86	:= y
endif


build/distros/alpine/alpine-@DISTRO_VERSION@-x86.inc.in: src/distros/alpine/grub-distro.inc.in src/cfg/grub-distro-keywords.cfg.in
	@SED_FILE="$(<)"; \
		SED_INCLUDE="src/cfg/grub-distro-keywords.cfg.in"; \
		SED_KEYWORD="[@]DISTRO_VER_METADATA[@]"; \
		$(do_include);


build/distros/alpine/alpine-@DISTRO_VERSION@-x86.inc: build/distros/alpine/alpine-@DISTRO_VERSION@-x86.inc.in .config
	@$(DISTRO_ALPINE_KEYWORDS) \
		DISTRO_VERSION=@DISTRO_VERSION@; \
		DISTRO_VER_OPT=$(DISTRO_ALPINE_@DISTRO_TAG@_x86); \
		DISTRO_VER_ARCH=x86; \
		DISTRO_VER_PATH='/v@DISTRO_VERSION@'; \
		$(do_subst_file_dt)


#
# Alpine Linux @DISTRO_VERSION@ (x86_64)
#
DISTRO_ALPINE_@DISTRO_TAG@_x8664		?= n
ifneq ($(DISTRO_ALPINE_@DISTRO_TAG@_x8664), n)
   DISTRO_ALPINE_CFG		+= build/distros/alpine/alpine-@DISTRO_VERSION@-x86_64.inc
endif
ifeq ($(DISTRO_ALPINE_@DISTRO_TAG@_x8664), d)
   DISTRO_ALPINE_BOOT		+= boot/alpine/v@DISTRO_VERSION@/main/x86_64/.iperd
else ifneq ($(DISTRO_ALPINE_@DISTRO_TAG@_x8664), l)
   DISTRO_ALPINE_@DISTRO_TAG@_x8664	:= y
endif


build/distros/alpine/alpine-@DISTRO_VERSION@-x86_64.inc.in: src/distros/alpine/grub-distro.inc.in src/cfg/grub-distro-keywords.cfg.in
	@SED_FILE="$(<)"; \
		SED_INCLUDE="src/cfg/grub-distro-keywords.cfg.in"; \
		SED_KEYWORD="[@]DISTRO_VER_METADATA[@]"; \
		$(do_include);


build/distros/alpine/alpine-@DISTRO_VERSION@-x86_64.inc: build/distros/alpine/alpine-@DISTRO_VERSION@-x86_64.inc.in .config
	@$(DISTRO_ALPINE_KEYWORDS) \
		DISTRO_VERSION=@DISTRO_VERSION@; \
		DISTRO_VER_OPT=$(DISTRO_ALPINE_@DISTRO_TAG@_x8664); \
		DISTRO_VER_ARCH=x86_64; \
		DISTRO_VER_PATH='/v@DISTRO_VERSION@'; \
		$(do_subst_file_dt)

