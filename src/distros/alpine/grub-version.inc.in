
   # Alpine Linux  @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)
   iperd_distro_opt_desc distro_ver_opt "@DISTRO_VER_OPT@";
   menuentry "Alpine Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@) [${distro_ver_opt}]" {
      @DISTRO_VER_METADATA@

      iperd_distro_ver_metadata \
             'Alpine Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
             '@DISTRO_VER_OPT@';

      echo   'loading vmlinuz-lts ...'
      linux  ${distro_ver_grub}/releases/@DISTRO_VER_ARCH@/netboot/vmlinuz-lts \
             modloop=${distro_ver_url}/releases/@DISTRO_VER_ARCH@/netboot/modloop-lts \
             modules=loop,squashfs,sd-mod,usb-storage \
             alpine_repo=${distro_ver_url}/main \
             ip=dhcp:::::eth0: \
             console=${iperd_linux_console} \
             ${distro_ver_append}
      echo   'loading initramfs-lts ...'
      initrd ${distro_ver_grub}/releases/@DISTRO_VER_ARCH@/netboot/initramfs-lts
      echo   'booting system ...'
   }

