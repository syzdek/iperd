
   set distro_ver_opt="@DISTRO_OPT@";
   iperd_distro_ver_desc
   submenu "Fedora Linux @DISTRO_VERSION@ Installers (@DISTRO_ARCH@) [${distro_ver_loc}]" {
      if [ "@DISTRO_OPT@x" == "dx" ]; then
         set distro_ver_grub="${iperd_grub}/boot/fedora/@DISTRO_VERSION@/Everything/@DISTRO_ARCH@"
         set distro_ver_url="@DISTRO_URL@/@DISTRO_VERSION@/Everything/@DISTRO_ARCH@"
      elif [ "@DISTRO_OPT@x" == "lx" ]; then
         set distro_ver_grub="@DISTRO_LOCAL_GRUB@/@DISTRO_VERSION@/Everything/@DISTRO_ARCH@"
         set distro_ver_url="@DISTRO_LOCAL_URL@/@DISTRO_VERSION@/Everything/@DISTRO_ARCH@"
      else
         set distro_ver_grub="@DISTRO_GRUB@/@DISTRO_VERSION@/Everything/@DISTRO_ARCH@"
         set distro_ver_url="@DISTRO_URL@/@DISTRO_VERSION@/Everything/@DISTRO_ARCH@"
      fi
      export distro_ver_grub
      export distro_ver_url
      menuentry "Install Fedora @DISTRO_VERSION@" {
         echo   'Rocky Linux @DISTRO_VERSION@ (@DISTRO_ARCH@)'
         echo   "${distro_ver_loc}: ${distro_ver_grub}"
         echo   'Loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                ramdisk_size=100000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_url}/os/ \
                inst.stage2=${distro_ver_url}/os \
                console=${iperd_console} \
                ${distro_append}
         echo   'Loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Install Fedora @DISTRO_VERSION@ in basic graphics mode" {
         echo   'Rocky Linux @DISTRO_VERSION@ (@DISTRO_ARCH@)'
         echo   "${distro_ver_loc}: ${distro_ver_grub}"
         echo   'Loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                nomodeset ramdisk_size=100000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_url}/os/ \
                inst.stage2=${distro_ver_url}/os \
                console=${iperd_console} \
                ${distro_append}
         echo   'Loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Rescue a Fedora system" {
         echo   'Rocky Linux @DISTRO_VERSION@ (@DISTRO_ARCH@)'
         echo   "${distro_ver_loc}: ${distro_ver_grub}"
         echo   'Loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                ramdisk_size=100000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_url}/os/ \
                inst.stage2=${distro_ver_url}/os \
                rescue \
                console=${iperd_console} \
                ${distro_append}
         echo   'Loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
   }
