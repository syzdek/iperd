
   set distro_ver_opt="@DISTRO_VER_OPT@";
   iperd_distro_ver_calc
   submenu "Fedora Linux @DISTRO_VERSION@ Installers (@DISTRO_VER_ARCH@) [${distro_ver_loc}] ..." {

      set distro_alias="fedora";
      set distro_ver_opt="@DISTRO_VER_OPT@";
      set distro_local_grub="@DISTRO_LOCAL_GRUB@";
      set distro_local_url="@DISTRO_LOCAL_URL@";
      set distro_pub_grub="@DISTRO_PUB_GRUB@";
      set distro_pub_url="@DISTRO_PUB_URL@";

      iperd_distro_ver_calc;

      set distro_ver_suffix="@DISTRO_VERSION@/Everything/@DISTRO_VER_ARCH@";
      set distro_ver_grub="${distro_ver_grub}/${distro_ver_suffix}";
      set distro_ver_url="${distro_ver_url}/${distro_ver_suffix}";

      export distro_ver_grub;
      export distro_ver_url;
      export distro_ver_append;
      export distro_ver_loc;

      set iperd_verbose_str='Fedora Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)'
      export iperd_verbose_str

      menuentry "Install Fedora @DISTRO_VERSION@" {
         iperd_distro_ver_info
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                ramdisk_size=100000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_url}/os/ \
                inst.stage2=${distro_ver_url}/os \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Install Fedora @DISTRO_VERSION@ in basic graphics mode" {
         iperd_distro_ver_info
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                nomodeset ramdisk_size=100000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_url}/os/ \
                inst.stage2=${distro_ver_url}/os \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Rescue a Fedora system" {
         iperd_distro_ver_info
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                ramdisk_size=100000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_url}/os/ \
                inst.stage2=${distro_ver_url}/os \
                rescue \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
   }
