
   # Fedora Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)
   iperd_distro_opt_desc distro_ver_opt "@DISTRO_VER_OPT@";
   submenu "Fedora Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@) [${distro_ver_opt}] ..." {
       @DISTRO_VER_METADATA@

      menuentry "Install Fedora @DISTRO_VERSION@" {
         iperd_distro_ver_metadata \
                'Fedora Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                ramdisk_size=400000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_repo}/os/ \
                inst.stage2=${distro_ver_repo}/os \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Install Fedora @DISTRO_VERSION@ in basic graphics mode" {
         iperd_distro_ver_metadata \
                'Fedora Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                nomodeset ramdisk_size=400000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_repo}/os/ \
                inst.stage2=${distro_ver_repo}/os \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
      menuentry "Rescue a Fedora system" {
         iperd_distro_ver_metadata \
                'Fedora Linux @DISTRO_VERSION@ (@DISTRO_VER_ARCH@)' \
                '@DISTRO_VER_OPT@';
         echo   'loading vmlinuz ...'
         linux  ${distro_ver_grub}/os/images/pxeboot/vmlinuz \
                ramdisk_size=400000 ip=dhcp net.ifnames=0 \
                inst.repo=${distro_ver_repo}/os/ \
                inst.stage2=${distro_ver_repo}/os \
                rescue \
                console=${iperd_linux_console} \
                ${distro_ver_append}
         echo   'loading initrd.img ...'
         initrd ${distro_ver_grub}/os/images/pxeboot/initrd.img
         echo   'booting system ...'
      }
   }

