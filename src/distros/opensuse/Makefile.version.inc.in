
#
# openSUSE @DISTRO_VERSION@
#
DISTRO_OPENSUSE_@DISTRO_TAG@			?= n
ifneq ($(DISTRO_OPENSUSE_@DISTRO_TAG@), n)
   DISTRO_OPENSUSE_CFG		+= build/distros/opensuse/opensuse-@DISTRO_VERSION@.inc
endif
ifeq ($(DISTRO_OPENSUSE_@DISTRO_TAG@), d)
   DISTRO_OPENSUSE_BOOT		+= boot/opensuse/distribution/leap/@DISTRO_VERSION@/repo/oss/boot/x86_64/loader/initrd
   DISTRO_OPENSUSE_BOOT		+= boot/opensuse/distribution/leap/@DISTRO_VERSION@/repo/oss/boot/x86_64/loader/linux
else ifneq ($(DISTRO_OPENSUSE_@DISTRO_TAG@), l)
   DISTRO_OPENSUSE_@DISTRO_TAG@		:= y
endif


build/distros/opensuse/opensuse-@DISTRO_VERSION@.inc: src/distros/opensuse/grub-distro.inc.in .config
	@$(DISTRO_OPENSUSE_KEYWORDS) \
		DISTRO_VERSION=@DISTRO_VERSION@; \
		DISTRO_OPT=$(DISTRO_OPENSUSE_@DISTRO_TAG@); \
		DISTRO_ARCH=x86_64; \
		$(do_subst_file_dt)

