#
# configure serial console early to display warnings/errors
#
serial --unit @GRUB_SERIAL_DEV@ --speed @GRUB_SERIAL_BAUD@
terminal_input  serial console
terminal_output serial console
clear


#
# IPERD GRUB Functions
#

function echo_bool {
   set echo_bool_title="${1}";
   set echo_bool_val="${2}";
   if [ "x${echo_bool_val}" == "x" ]; then
      set echo_bool_val="n/a"
   elif [ ${echo_bool_val} == "y" ]; then
      set echo_bool_val="yes"
   elif [ ${echo_bool_val} == "n" ]; then
      set echo_bool_val="no"
   elif [ ${echo_bool_val} == "a" ]; then
      set echo_bool_val="abort"
   else
      set echo_bool_val="unknown"
   fi
   echo "${echo_bool_title}${echo_bool_val}";
   unset echo_bool_title
   unset echo_bool_val
}


function iperd_continue {
   echo "";
   if [ "x${1}" == "x" ]; then
      echo "press [enter] to continue";
   else
      echo "press [enter] to ${1}";
   fi;
   read -s;
   echo "";
}


function iperd_distro_opt_desc {
   set tmp_attr="${1}";
   set tmp_ver_opt="${2}";

   if [ "x${tmp_ver_opt}" == "xd" ]; then
      if [ "x${iperd_pxe}" == "xn" ]; then
         set ${tmp_attr}="Local Media";
      else
         set ${tmp_attr}="Netboot Server";
      fi;
   elif [ "x${tmp_ver_opt}" == "xl" ]; then
      set ${tmp_attr}="Local Mirror";
   else
      set ${tmp_attr}="Internet";
   fi

   unset tmp_attr;
   unset tmp_ver_opt;
}


function iperd_distro_ver_logic {
   set tmp_ver_opt="${1}";

   if [ "x${distro_pub_repo}" == "x" ]; then
      set distro_pub_repo="${distro_pub_url}";
   fi

   if [ "x${tmp_ver_opt}" == "xd" ]; then
      #
      # variable values for downloaded images
      #
      if [ "x${distro_download_repo}" == "x" ]; then
         set distro_download_repo="${distro_pub_repo}";
      fi;
      if [ "x${distro_download_append}" == "x" ]; then
         set distro_download_append="${distro_pub_append}";
      fi;
      set distro_ver_url="${iperd_url}/boot/${distro_alias}";
      set distro_ver_repo="${distro_download_repo}";
      set distro_ver_grub="${iperd_grub}/boot/${distro_alias}";
      set distro_ver_append="${distro_download_append}";
   elif [ "x${tmp_ver_opt}" == "xl" ]; then
      #
      # variable values for images on local mirrors
      #
      if [ "x${distro_local_url}" == "x" ]; then
         set distro_local_url="${distro_pub_url}";
      fi;
      if [ "x${distro_local_repo}" == "x" ]; then
         set distro_local_repo="${distro_local_url}";
      fi;
      if [ "x${distro_local_grub}" == "x" ]; then
         set distro_local_grub="${distro_pub_grub}";
      fi;
      if [ "x${distro_local_append}" == "x" ]; then
         set distro_local_append="${distro_pub_append}";
      fi;
      set distro_ver_url="${distro_local_url}";
      set distro_ver_repo="${distro_local_repo}";
      set distro_ver_grub="${distro_local_grub}";
      set distro_ver_append="${distro_local_append}";
   else
      #
      # variable values for images on Internet
      #
      set distro_ver_url="${distro_pub_url}";
      set distro_ver_repo="${distro_pub_repo}";
      set distro_ver_grub="${distro_pub_grub}";
      set distro_ver_append="${distro_pub_append}";
   fi;

   set distro_ver_url="${distro_ver_url}${distro_ver_path}"
   set distro_ver_repo="${distro_ver_repo}${distro_ver_path}"
   set distro_ver_grub="${distro_ver_grub}${distro_ver_path}"

   export distro_ver_url
   export distro_ver_repo
   export distro_ver_grub
   export distro_ver_append

   unset tmp_ver_opt;
}


function iperd_distro_ver_metadata {

   set distro_ver_title="${1}";
   set distro_ver_opt="${2}";

   iperd_distro_opt_desc distro_ver_optstr ${distro_ver_opt};

   if [ "x${distro_ver_title}" != "x" ]; then
      echo "${1} [${distro_ver_optstr}]"
   fi

   if [ ${iperd_verbose} == "y" ]; then
      if [ ${iperd_debug} == "n" ]; then
         echo "   GRUB Path:  ${distro_ver_grub}"
         echo "   Distro URL: ${distro_ver_url}"
      else
         echo "   GRUB Variables:"
         echo "      iperd_linux_console:     ${iperd_linux_console}"
         echo "      iperd_url:               ${iperd_url}"
         echo "      iperd_grub:              ${iperd_grub}"
         echo "      distro_alias:            ${distro_alias}"
         if [ "x${distro_ver_opt}" == "xd" ]; then
            echo "      distro_download_repo:    ${distro_download_repo}"
            echo "      distro_download_append:  ${distro_download_append}"
         elif [ "x${distro_ver_opt}" == "xl" ]; then
            echo "      distro_local_url:        ${distro_local_url}"
            echo "      distro_local_repo:       ${distro_local_repo}"
            echo "      distro_local_grub:       ${distro_local_grub}"
            echo "      distro_local_append:     ${distro_local_append}"
         else
            echo "      distro_pub_url:          ${distro_pub_url}"
            echo "      distro_pub_repo:         ${distro_pub_repo}"
            echo "      distro_pub_grub:         ${distro_pub_grub}"
            echo "      distro_pub_append:       ${distro_pub_append}"
         fi
         echo "      distro_ver_opt:          ${distro_ver_opt}"
         echo "      distro_ver_path:         ${distro_ver_path}"
         echo "      distro_ver_url:          ${distro_ver_url}"
         echo "      distro_ver_repo:         ${distro_ver_repo}"
         echo "      distro_ver_grub:         ${distro_ver_grub}"
         echo "      distro_ver_append:       ${distro_ver_append}"
         iperd_continue "continue bootings"
      fi
   fi

   unset distro_ver_title;
   unset distro_ver_opt;
   unset distro_ver_optstr;
}


function iperd_network_calc {
   set tmp_attr="${1}"
   set tmp_net1="${2}"
   set tmp_net2="${3}"
   set tmp_str="${4}"

   regexp --set tmp_val1 '^(([0-9]{1,3}.){3})' "${tmp_net1}"
   regexp --set tmp_val2 '^(([0-9]{1,3}.){3})' "${tmp_net2}"

   if [ ${tmp_attr} != "" ]; then
      if [ "${tmp_val1}" != "${tmp_val2}" ]; then
         set ${tmp_attr}="${tmp_val1}${tmp_str}";
      fi
   fi

   unset tmp_attr
   unset tmp_net1
   unset tmp_net2
   unset tmp_str
}


function iperd_notice {
   echo "                     IP Engineering Rescue Disk"
   echo "      The IP Engineering Rescue Disk (IPERD) uses the GNU GRUB"
   echo "      bootloader to boot utilities, installers, and operating"
   echo "      systems. The IPERD boot menu will not modify the system,"
   echo "      however images booted by IPERD may modify the system."
}


function iperd_print_verbose {
   if [ ${iperd_verbose} == "y" ]; then
      echo "${1}"
   fi
}


function iperd_prompt_bool {
   set iperd_prompt_attr="${1}";
   set iperd_prompt_title="${2}";
   set iperd_prompt_dflt="${3}";
   set iperd_prompt_abort="${4}";

   set iperd_prompt_continue='n';

   while [ "x${iperd_prompt_continue}" == "xn" ]; do
      if [ "x${iperd_prompt_dflt}" != "x" ]; then
         if [ "${iperd_prompt_dflt}" == "y" ]; then
            set iperd_prompt_dflt="yes"
         elif [ ${iperd_prompt_dflt} == "n" ]; then
            set iperd_prompt_dflt="no"
         elif [ ${iperd_prompt_dflt} == "a" ]; then
            set iperd_prompt_dflt="abort"
         fi
         if [ "x${iperd_prompt_abort}" == "xy" ]; then
            echo -n "${iperd_prompt_title} (yes/no/abort) [${iperd_prompt_dflt}]: "
         else
            echo -n "${iperd_prompt_title} (yes/no) [${iperd_prompt_dflt}]: "
         fi
      elif [ "x${iperd_prompt_abort}" == "xy" ]; then
         echo -n "${iperd_prompt_title} (yes/no/abort): "
      else
         echo -n "${iperd_prompt_title} (yes/no): "
      fi
      read iperd_prompt_input
      echo ""
      if [ "x${iperd_prompt_input}" == "x" ]; then
         if [ "x${iperd_prompt_dflt}" != "x" ]; then
            set iperd_prompt_input="${iperd_prompt_dflt}"
         fi
      fi
      if [ "x${iperd_prompt_input}" == "xy" ]; then
         set iperd_prompt_continue="y"
      elif [ "x${iperd_prompt_input}" == "xyes" ]; then
         set iperd_prompt_input="y"
         set iperd_prompt_continue="y"
      elif [ "x${iperd_prompt_input}" == "xn" ]; then
         set iperd_prompt_continue="y"
      elif [ "x${iperd_prompt_input}" == "xno" ]; then
         set iperd_prompt_input="n"
         set iperd_prompt_continue="y"
      elif [ "x${iperd_prompt_abort}" == "xy" ]; then
         if [ "x${iperd_prompt_input}" == "xa" ]; then
            set iperd_prompt_continue="y"
         elif [ "x${iperd_prompt_input}" == "xabort" ]; then
            set iperd_prompt_input="a"
               set iperd_prompt_continue="y"
         fi
      fi
   done

   if [ ${iperd_prompt_attr} != "" ]; then
      set ${iperd_prompt_attr}="${iperd_prompt_input}";
   fi

   unset iperd_prompt_attr;
   unset iperd_prompt_title;
   unset iperd_prompt_dflt;
   unset iperd_prompt_abort;
   unset iperd_prompt_continue;
   unset iperd_prompt_input;
}


function iperd_prompt_str {
   set iperd_prompt_attr="${1}";
   set iperd_prompt_title="${2}";
   set iperd_prompt_dflt="${3}";
   set iperd_prompt_regex="${4}";

   set iperd_prompt_continue=n;

   if [ ${iperd_prompt_regex} == "" ]; then
      set iperd_prompt_regex='^.*$';
   fi

   while [ "x${iperd_prompt_continue}" == "xn" ]; do
      if [ "x${iperd_prompt_dflt}" != "x" ]; then
         echo -n "${iperd_prompt_title} [${iperd_prompt_dflt}]: "
      else
         echo -n "${iperd_prompt_title}: "
      fi
      read iperd_prompt_input
      echo ""
      if [ "x${iperd_prompt_input}" == "x" ]; then
         if [ "x${iperd_prompt_dflt}" != "x" ]; then
            set iperd_prompt_input="${iperd_prompt_dflt}"
         fi
      elif [ "x${iperd_prompt_input}" == "x " ]; then
         set iperd_prompt_input=""
      fi
      if [ ${iperd_prompt_regex} != "" ]; then
         regexp ${iperd_prompt_regex} ${iperd_prompt_input}
         if [ ${?} == "0" ]; then
            set iperd_prompt_continue=y
         fi
      else
         set iperd_prompt_continue=y
      fi
   done

   if [ ${iperd_prompt_attr} != "" ]; then
      set ${iperd_prompt_attr}="${iperd_prompt_input}";
   fi

   unset iperd_prompt_attr;
   unset iperd_prompt_title;
   unset iperd_prompt_regex;
   unset iperd_prompt_dflt;
   unset iperd_prompt_continue;
   unset iperd_prompt_input;

   return 0;
}


function iperd_source {
   set iperd_source_loaded="n";
   if [ "x${feature_net_search_cfg}" != "xn" ]; then
      if [ "x${net_default_mac}" != "x" ]; then

         # generate regex
         set iperd_regex="^";
         for iperd_count in "1" "2" "3" "4" "5"; do
            set iperd_regex="${iperd_regex}([[:xdigit:]])([[:xdigit:]]):";
         done
         set iperd_regex="${iperd_regex}([[:xdigit:]])([[:xdigit:]])\$";
         unset iperd_count

         regexp --set  1:iperd_str1  "${iperd_regex}" ${net_default_mac}
         regexp --set  2:iperd_str2  "${iperd_regex}" ${net_default_mac}
         regexp --set  3:iperd_str3  "${iperd_regex}" ${net_default_mac}
         regexp --set  4:iperd_str4  "${iperd_regex}" ${net_default_mac}
         regexp --set  5:iperd_str5  "${iperd_regex}" ${net_default_mac}
         regexp --set  6:iperd_str6  "${iperd_regex}" ${net_default_mac}
         regexp --set  7:iperd_str7  "${iperd_regex}" ${net_default_mac}
         regexp --set  8:iperd_str8  "${iperd_regex}" ${net_default_mac}
         regexp --set  9:iperd_str9  "${iperd_regex}" ${net_default_mac}
         regexp --set 10:iperd_str10 "${iperd_regex}" ${net_default_mac}
         regexp --set 11:iperd_str11 "${iperd_regex}" ${net_default_mac}
         regexp --set 12:iperd_str12 "${iperd_regex}" ${net_default_mac}
         unset iperd_regex

         set iperd_str0="";
         set iperd_str1="${iperd_str0}${iperd_str1}";
         set iperd_str2="${iperd_str1}${iperd_str2}";
         set iperd_str3="${iperd_str2}-${iperd_str3}";
         set iperd_str4="${iperd_str3}${iperd_str4}";
         set iperd_str5="${iperd_str4}-${iperd_str5}";
         set iperd_str6="${iperd_str5}${iperd_str6}";
         set iperd_str7="${iperd_str6}-${iperd_str7}";
         set iperd_str8="${iperd_str7}${iperd_str8}";
         set iperd_str9="${iperd_str8}-${iperd_str9}";
         set iperd_str10="${iperd_str9}${iperd_str10}";
         set iperd_str11="${iperd_str10}-${iperd_str11}";
         set iperd_str12="${iperd_str11}${iperd_str12}";

         for iperd_str in ${iperd_str12} ${iperd_str11} ${iperd_str10} ${iperd_str9} ${iperd_str8} ${iperd_str7} ${iperd_str6} ${iperd_str5} ${iperd_str4} ${iperd_str3} ${iperd_str2} ${iperd_str1}; do
            if [ "x${iperd_source_loaded}" == "xn" ] ; then
               source ${iperd_source_file}-${iperd_str}
            fi
         done

         unset iperd_str
         unset iperd_str0
         unset iperd_str1
         unset iperd_str2
         unset iperd_str3
         unset iperd_str4
         unset iperd_str5
         unset iperd_str6
         unset iperd_str7
         unset iperd_str8
         unset iperd_str9
         unset iperd_str10
         unset iperd_str11
         unset iperd_str12
      fi
   fi

   if [ "x${iperd_source_loaded}" == "xn" ] ; then
      source ${iperd_source_file}
   fi

   unset iperd_source_loaded
   unset iperd_source_file
}


#
# load common modules
#
insmod all_video

insmod net
insmod http
insmod fat
insmod chain
insmod usb
#insmod usb_keyboard
insmod usbms
insmod serial
insmod regexp
insmod test
insmod read


if [ ${grub_platform} == "efi" ]; then
   insmod efifwsetup
   insmod efi_gop
   insmod efi_uga
else
   insmod vbe
fi


#
# set initial terminal options
#
set iperd_term_type="@GRUB_TERM@"
set iperd_term_geometry="@GRUB_TERM_GEOMETRY@"
set iperd_term_utf8="@GRUB_TERM_UTF8@"
if [ "x${iperd_term_type}" == "x" ]; then
   set iperd_term_type="vt100"
fi
if [ "x${iperd_term_geometry}" == "x" ] ;then
   set iperd_term_geometry="80x24"
fi
terminfo --ascii -g ${iperd_term_geometry} serial ${iperd_term_type}
#terminfo --utf8 -g 80x24 serial vt100-color


#
# set text menu theme
#
set color_normal='white/black'
set color_highlight='white/black'
set menu_color_normal='white/blue'
set menu_color_highlight='blue/white'
export color_normal
export color_highlight
export menu_color_normal
export menu_color_highlight


#
# default values
#
set iperd_verbose="@IPERD_VERBOSE@"
set iperd_debug="@IPERD_DEBUG@"
set iperd_progress='@IPERD_PROGRESS@'
set iperd_net_card="@IPERD_NET_CARD@"
set iperd_net_ip="@IPERD_NET_IP@"
set iperd_net_network="@IPERD_NET_NETWORK@"
set iperd_net_gw="@IPERD_NET_GW@"
set iperd_net_vlan="@IPERD_NET_VLAN@"
set iperd_net_dns="@IPERD_NET_DNS@"
set iperd_linux_console="@LINUX_CONSOLE@"
set iperd_use_gfxterm="@GRUB_USE_GFXTERM@"
export iperd_verbose
export iperd_debug
export iperd_linux_console


#
# check PXE status and set initial network preferences
#
regexp --set iperd_tftp_ip "tftp,(.+)" ${root}
set iperd_net="n"
if [ ${iperd_tftp_ip} != "" ]; then
   set iperd_grub="(http,${iperd_tftp_ip})@IPERD_DIR_NET@"
   set iperd_url="http://${iperd_tftp_ip}@IPERD_DIR_NET@"
   set iperd_pxe="y"
   set iperd_net="n"
   set iperd_feature_networking='y'
else
   set iperd_grub="(${root})@IPERD_DIR_DISK@"
   set iperd_url="@IPERD_DIR_DISK@"
   set iperd_pxe="n"
   if [ "x${net_default_interface}" != "x" ]; then
      set iperd_net="@IPERD_NET@"
      set iperd_feature_networking='y'
   elif [ ${grub_platform} == "efi" ]; then
      set iperd_net="@IPERD_NET@"
      set iperd_feature_networking='y'
   fi
fi
export iperd_grub
export iperd_url
export iperd_pxe
export iperd_net
export iperd_feature_networking


#
# attempt to load config include with host specific defaults
#
set iperd_source_file="(${root})/local/variables.cfg"
iperd_source


#
# Prompt user to review setup options
#
if [ "x@IPERD_RUNTIME_NOTICE@" == "xy" ]; then
   echo ""
   echo ""
   iperd_notice
fi
if [ "x@IPERD_RUNTIME_SETUP@" == "xy" ]; then
   set iperd_continue="n"
   while [ ${iperd_continue} == "n" ]; do
      echo      ""
      echo      ""
      echo      "      IP Engineering Rescue Disk @IPERD_VERSION@"
      echo      ""
      echo      "Review Configuration:"
      echo      "   Linux Console Device:      ${iperd_linux_console}"
      echo      "   IPERD GRUB Prefix:         ${iperd_grub}"
      echo      "   IPERD Boot URL:            ${iperd_url}"
      echo_bool "   IPERD Show Progress:       " "${iperd_progress}"
      echo_bool "   IPERD Verbose Messages:    " "${iperd_verbose}"
      if [ "${iperd_verbose}" == "y" ]; then
         echo_bool "   IPERD Debug Messages:      " "${iperd_debug}";
      fi
      if [ "x${iperd_feature_networking}" == "xy" ]; then
         echo_bool "   Manual Network Setup:      " "${iperd_net}"
         if [ ${iperd_net} == "y" ]; then
            echo "      Network Card:           ${iperd_net_card}"
            if [ ${iperd_net_card} == "any" ]; then
               echo "      IP Address:             dhcp";
            elif [ ${iperd_net_ip} != "dhcp" ]; then
               echo "      IP Address:             ${iperd_net_ip}"
               echo "      Network:                ${iperd_net_network}"
               echo "      Network VLAN:           ${iperd_net_vlan}"
               echo "      Default Gateway:        ${iperd_net_gw}"
               echo "      DNS Server:             ${iperd_net_dns}"
            else
               echo "      IP Address:             ${iperd_net_ip}"
            fi
         fi
      fi
      echo_bool "   GRUB Graphics Terminal:    " "${iperd_use_gfxterm}"
      echo      "   GRUB Serial Term Type:     ${iperd_term_type}"
      echo      "   GRUB Serial Term Geometry: ${iperd_term_geometry}"
      echo_bool "   GRUB Serial Term UTF-8:    " "${iperd_term_utf8}"
      echo      ""

      iperd_prompt_bool iperd_continue "Is the above correct";
      if [ "x${iperd_continue}" == "xa" ]; then
         echo "exiting IPERD/GRUB ..."
         exit
      fi

      if [ ${iperd_continue} == "n" ]; then
         echo ""
         echo "The following are common Linux console devices:"
         echo ""
         echo "   tty0          - physical video console, most commonly used"
         echo "   ttyS0         - serial console on com1"
         echo "   ttyS1         - serial console on com2"
         echo "   ttyUSB0       - serial console on USB-to-serial converter"
         echo ""
         echo "The following are common values:"
         echo ""
         echo "   tty0         - most common configuration"
         echo "   ttyS0,9600   - com1 using traditional baud rate"
         echo "   ttyS0,115200 - com1 using baud rate common for modern systems"
         echo "   ttyS1,115200 - com2 using baud rate common for IPMI"
         echo ""
         iperd_prompt_str \
            iperd_linux_console \
            "Linux Console Device" \
            "${iperd_linux_console}" \
            '^.+$'

         iperd_prompt_str \
            iperd_grub \
            "IPERD GRUB Prefix" \
            "${iperd_grub}" \
            '^.+$'

         iperd_prompt_str \
            iperd_url \
            "IPERD Boot URL" \
            "${iperd_url}" \
            '^.+$'

         iperd_prompt_bool \
            iperd_progress \
            "IPERD Show Progress" \
            "${iperd_progress}"

         iperd_prompt_bool \
            iperd_verbose \
            "IPERD Verbose Messages" \
            "${iperd_verbose}"

         # IPERD Debug Messages
         if [ "${iperd_verbose}" == "y" ]; then
            iperd_prompt_bool \
               iperd_debug \
               "IPERD Debug Messages" \
               "${iperd_debug}"
         fi

         if [ "x${iperd_feature_networking}" == "xy" ]; then

            set iperd_net_continue='y';

            # GRUB Configure Network
            iperd_prompt_bool \
               iperd_net \
               "Manual Network Setup" \
               "${iperd_net}";
            if [ ${iperd_net} != 'y' ]; then
               set iperd_net_continue='n';
            fi

            # Network Interface
            if [ ${iperd_net_continue} == "y" ]; then
               echo ""
               echo "Available Network Cards:"
               net_ls_cards
               echo ""
               iperd_prompt_str \
                  iperd_net_card \
                  "Network Card (e.g. efinet0, any, etc)" \
                  "${iperd_net_card}" \
                  '^[-.:a-zA-Z0-9]+$';
               if [ ${iperd_net_card} == 'any' ]; then
                  set iperd_net_continue='n';
               fi
            fi

            # IP Address
            if [ ${iperd_net_continue} == "y" ]; then
               iperd_prompt_str \
                  iperd_net_ip \
                  "IP Address" \
                  "${iperd_net_ip}" \
                  '^(dhcp|([0-9]{1,3}.){3}[0-9]{1,3})$';
               if [ ${iperd_net_ip} == 'dhcp' ]; then
                  set iperd_net_continue='n';
               fi
            fi

            # Network
            if [ ${iperd_net_continue} == "y" ]; then
                iperd_network_calc \
                   iperd_net_network \
                   "${iperd_net_ip}" \
                   "${iperd_net_network}" \
                   "0/24";
                iperd_prompt_str \
                   iperd_net_network \
                   "Network" \
                   "${iperd_net_network}" \
                   '^([0-9]{1,3}.){3}[0-9]{1,3}/([0-9]|[12][0-9]|30)$';
            fi

            # VLAN
            if [ ${iperd_net_continue} == "y" ]; then
                iperd_prompt_str \
                   iperd_net_vlan \
                   "Network VLAN" \
                   "${iperd_net_vlan}" \
                   '^([1-3]{0,1}[0-9]{1,3}|40[0-8][0-9]|409[0-5])$';
            fi

            # Default Gateway
            if [ ${iperd_net_continue} == "y" ]; then
                iperd_network_calc \
                   iperd_net_gw \
                   "${iperd_net_ip}" \
                   "${iperd_net_gw}" \
                   "1";
               iperd_prompt_str \
                  iperd_net_gw \
                  "Default Gateway" \
                  "${iperd_net_gw}" \
                  '^(dhcp|([0-9]{1,3}.){3}[0-9]{1,3})$';
            fi

            # DNS Server
            if [ ${iperd_net_continue} == "y" ]; then
               iperd_prompt_str \
                  iperd_net_dns \
                  "DNS Server" \
                  "${iperd_net_dns}" \
                  '^(dhcp|([0-9]{1,3}.){3}[0-9]{1,3})$';
            fi

         fi

         iperd_prompt_bool \
            iperd_use_gfxterm \
            "GRUB Graphics Terminal" \
            "${iperd_use_gfxterm}";

         echo ""
         echo "GRUB supports the following serial terminal types:"
         echo ""
         echo "   vt100"
         echo "   vt100-color"
         echo "   ieee1275"
         echo "   dumb"
         echo ""
         iperd_prompt_str \
            iperd_term_type \
            "GRUB Serial Term Type" \
            "${iperd_term_type}" \
            '^(vt100|vt100-color|ieee1275|dumb)$';

         echo ""
         echo "The following are common terminal geometries:"
         echo ""
         echo "   80x24     - Linux virtual console default"
         echo "   100x31    - common for BIOS/UEFI console redirection"
         echo ""
         iperd_prompt_str \
            iperd_term_geometry \
            "GRUB Serial Term Geometry" \
            "${iperd_term_geometry}" \
            '^[0-9]+x[0-9]+$'

         iperd_prompt_bool \
            iperd_term_utf8 \
            "GRUB Serial Term UTF-8" \
            "${iperd_term_utf8}"

      fi
   done
   unset iperd_continue
   echo ""
   echo ""
else
   echo ""
   echo ""
   echo "      IP Engineering Rescue Disk @IPERD_VERSION@"
   echo ""
   echo ""
fi
unset iperd_net_continue


#
# configure terminal
#
iperd_print_verbose "configuring terminal ..."
if [ ${iperd_term_utf8} == 'y' ]; then
   terminfo --utf8 -g ${iperd_term_geometry} serial ${iperd_term_type}
else
   terminfo --ascii -g ${iperd_term_geometry} serial ${iperd_term_type}
fi
if [ ${iperd_use_gfxterm} == "y" ]; then
   iperd_print_verbose "configuring gfxterm ..."
   insmod png
   insmod jpeg
   insmod gfxterm
   insmod font
   loadfont /grub/themes/iperd/dejavu_10.pf2
   loadfont /grub/themes/iperd/dejavu_12.pf2
   loadfont /grub/themes/iperd/dejavu_14.pf2
   loadfont /grub/themes/iperd/dejavu_14_bold.pf2
   loadfont /grub/themes/iperd/dejavu_14_bolditalic.pf2
   loadfont /grub/themes/iperd/dejavu_16.pf2
   loadfont /grub/themes/iperd/dejavu_18.pf2
   set theme=/grub/themes/iperd/theme.txt
   set gfxmode=1024x768x32,auto
   set gfxterm_font="/grub/themes/iperd/dejavu_12.pf2"
   export theme
   export gfxmode
   export gfxterm_font
   terminal_output serial gfxterm
fi


#
# configure network
#
if [ ${iperd_net} == "y" ]; then
   if [ "x${net_default_interface}" != "x" ]; then
      iperd_print_verbose "clearing existing network ..."
      net_del_addr  ${net_default_interface}
      net_del_route ${net_default_interface}:default
      net_del_route ${net_default_interface}:local
      if [ ${net_default_dns} != "" ]; then
         net_del_dns ${net_default_dns}
      fi
      unset net_default_ip
      unset net_default_mac
      unset net_default_server
   fi
   if [ ${iperd_net_card} == "any" ]; then
      echo "configuring network using DHCP ..."
      echo ""
      echo ""
      net_dhcp
   elif [ ${iperd_net_ip} == 'dhcp' ]; then
      set net_default_interface="${iperd_net_card}:dhcp"
      echo "configuring network using DHCP on ${iperd_net_card} ..."
      echo ""
      echo ""
      net_dhcp
   else
      echo "configuring network ..."
      echo ""
      echo ""
      set net_default_interface="${iperd_net_card}"
      net_add_addr ${iperd_net_card} ${iperd_net_card} ${iperd_net_ip}
      net_set_vlan ${iperd_net_card} ${iperd_net_vlan}
      if [ ${iperd_net_network} != "" ]; then
         net_del_route ${iperd_net_card}:local
         net_add_route ${iperd_net_card}:local ${iperd_net_network} ${iperd_net_card}
      fi
      if [ ${iperd_net_gw} != "" ]; then
         net_add_route ${iperd_net_card}:default 0.0.0.0/0 gw ${iperd_net_gw}
      fi
      if [ ${iperd_net_dns} != "" ]; then
         net_add_dns ${iperd_net_dns}
      fi
      if [ ${iperd_verbose} == 'y' ]; then
         net_ls_addr
         net_ls_routes
         net_ls_dns
      fi
   fi
fi


set pager=0
export pager


#
# load progress module
#
if [ ${iperd_progress} == 'y' ]; then
   insmod progress
fi


#
# attempt to load extra configurations
#
set iperd_source_file="(${root})/local/extra.cfg"
iperd_source


