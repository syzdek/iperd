serial --unit @GRUB_SERIAL_DEV@ --speed @GRUB_SERIAL_BAUD@
terminal_input  serial console
terminal_output serial console


function iperd_boolean {
   if [ "x${iperd_str}" == "x" ]; then
      set iperd_str="n/a"
   elif [ ${iperd_str} == "y" ]; then
      set iperd_str="yes"
   elif [ ${iperd_str} == "n" ]; then
      set iperd_str="no"
   fi
}


function iperd_boolean_prompt {
   if [ "x${iperd_prompt_str}" != "x" ]; then
      set iperd_prompt_continue="n"
      while [ "x${iperd_prompt_continue}" == "xn" ]; do
         if [ "x${iperd_prompt_dflt}" != "x" ]; then
            if [ "${iperd_prompt_dflt}" == "y" ]; then
               set iperd_prompt_dflt="yes"
            elif [ ${iperd_prompt_dflt} == "n" ]; then
               set iperd_prompt_dflt="no"
            fi
            if [ "x${iperd_prompt_abort}" == "xy" ]; then
               echo -n "${iperd_prompt_str} (yes/no/abort) [${iperd_prompt_dflt}]: "
            else
               echo -n "${iperd_prompt_str} (yes/no) [${iperd_prompt_dflt}]: "
            fi
         elif [ "x${iperd_prompt_abort}" == "xy" ]; then
            echo -n "${iperd_prompt_str} (yes/no/abort): "
         else
            echo -n "${iperd_prompt_str} (yes/no): "
         fi
         read iperd_prompt_input
         echo ""
         if [ "x${iperd_prompt_input}" == "x" ]; then
            if [ "x${iperd_prompt_dflt}" != "x" ]; then
               set iperd_prompt_input="${iperd_prompt_dflt}"
            fi
         fi
         if [ "x${iperd_prompt_input}" == "xy" ]; then
            set iperd_prompt_continue="y"
         elif [ "x${iperd_prompt_input}" == "xyes" ]; then
            set iperd_prompt_input="y"
            set iperd_prompt_continue="y"
         elif [ "x${iperd_prompt_input}" == "xn" ]; then
            set iperd_prompt_continue="y"
         elif [ "x${iperd_prompt_input}" == "xno" ]; then
            set iperd_prompt_input="n"
            set iperd_prompt_continue="y"
         elif [ "x${iperd_prompt_abort}" == "xy" ]; then
            if [ "x${iperd_prompt_input}" == "xa" ]; then
               set iperd_prompt_continue="y"
            elif [ "x${iperd_prompt_input}" == "xabort" ]; then
               set iperd_prompt_input="a"
               set iperd_prompt_continue="y"
            fi
         fi
      done
   fi
   set iperd_prompt_abort="n"
}


function iperd_str_prompt {
   if [ "x${iperd_prompt_str}" != "x" ]; then
      if [ "x${iperd_prompt_dflt}" != "x" ]; then
         echo -n "${iperd_prompt_str} [${iperd_prompt_dflt}]: "
      else
         echo -n "${iperd_prompt_str}: "
      fi
      read iperd_prompt_input
      echo ""
      if [ "x${iperd_prompt_input}" == "x" ]; then
         if [ "x${iperd_prompt_dflt}" != "x" ]; then
            set iperd_prompt_input="${iperd_prompt_dflt}"
         fi
      fi
      if [ "x${iperd_prompt_input}" == "x " ]; then
         set iperd_prompt_input=""
      fi
   fi
}


function iperd_distro_ver_desc {
   if [ "${distro_ver_opt}x" == "dx" ]; then
      if [ "x${iperd_pxe}" == "xn" ]; then
         set distro_ver_loc="Local Media";
      else
         set distro_ver_loc="Netboot Server";
      fi
   elif [ "${distro_ver_opt}x" == "lx" ]; then
      set distro_ver_loc="Local Mirror";
   else
      set distro_ver_loc="Internet";
   fi;
}


function iperd_distro_ver_paths {
   if [ "x${distro_ver_opt}" == "xd" ]; then
      set distro_ver_grub="${iperd_grub}/boot/${distro_name}";
      set distro_ver_url="${iperd_url}/boot/${distro_name}";
      set distro_ver_append="${distro_local_append}";
      if [ "x${iperd_pxe}" == "xn" ]; then
         set distro_ver_loc="Local Media";
      else
         set distro_ver_loc="Netboot Server";
      fi;
   elif [ "x${distro_ver_opt}" == "xl" ]; then
      set distro_ver_grub="${distro_local_grub}";
      set distro_ver_url="${distro_local_url}";
      set distro_ver_append="${distro_local_append}";
      set distro_ver_loc="Local Mirror";
   else
      set distro_ver_grub="${distro_grub}";
      set distro_ver_url="${distro_url}";
      set distro_ver_append="${distro_append}";
      set distro_ver_loc="Internet";
   fi;
}


function iperd_print_distro_verbose {
   if [ "x${iperd_verbose_str}" != "x" ]; then
      echo "${iperd_verbose_str} [${distro_ver_loc}]"
   fi
   if [ ${iperd_verbose} == "y" ]; then
      if [ ${iperd_debug} == "n" ]; then
         echo "   GRUB Path:  ${distro_ver_grub}"
         echo "   Distro URL: ${distro_ver_url}"
      else
         echo "   GRUB Variables:"
         echo "      iperd_grub:           ${iperd_grub}"
         echo "      iperd_url:            ${iperd_url}"
         echo "      distro_name:          ${distro_name}"
         echo "      distro_ver_opt:       ${distro_ver_opt}"
         echo "      distro_local_grub:    ${distro_local_grub}"
         echo "      distro_local_url:     ${distro_local_url}"
         echo "      distro_grub:          ${distro_grub}"
         echo "      distro_url:           ${distro_url}"
         echo "      distro_ver_suffix:    ${distro_ver_suffix}"
         echo "      distro_ver_grub:      ${distro_ver_grub}"
         echo "      distro_ver_url:       ${distro_ver_url}"
         echo "      distro_ver_append:    ${distro_ver_append}"
         echo "      iperd_linux_console:  ${iperd_linux_console}"
         echo ""
         echo "press [enter] to continue booting"
         read -s
         echo ""
      fi
   fi
}


function iperd_notice {
   echo "                     IP Engineering Rescue Disk"
   echo "      The IP Engineering Rescue Disk (IPERD) uses the GNU GRUB"
   echo "      bootloader to boot utilities, installers, and operating"
   echo "      systems. The IPERD boot menu will not modify the system,"
   echo "      however images booted by IPERD may modify the system."
}


insmod all_video

insmod net
insmod http
insmod fat
insmod chain
insmod usb
#insmod usb_keyboard
insmod usbms
insmod serial
insmod regexp


if [ ${grub_platform} == "efi" ]; then
   insmod efifwsetup
   insmod efi_gop
   insmod efi_uga
else
   insmod vbe
fi


#
# set initial terminal options
#
set iperd_term_type="@GRUB_TERM@"
set iperd_term_geometry="@GRUB_TERM_GEOMETRY@"
set iperd_term_utf8="@GRUB_TERM_UTF8@"
if [ "x${iperd_term_type}" == "x" ]; then
   set iperd_term_type="vt100"
fi
if [ "x${iperd_term_geometry}" == "x" ] ;then
   set iperd_term_geometry="80x24"
fi
terminfo --ascii -g ${iperd_term_geometry} serial ${iperd_term_type}
#terminfo --utf8 -g 80x24 serial vt100-color


#
# set text menu theme
#
set color_normal='white/black'
set color_highlight='white/black'
set menu_color_normal='white/blue'
set menu_color_highlight='blue/white'
export color_normal
export color_highlight
export menu_color_normal
export menu_color_highlight


set iperd_verbose="@IPERD_VERBOSE@"
set iperd_debug="@IPERD_DEBUG@"
export iperd_verbose
export iperd_debug


set iperd_use_gfxterm="@GRUB_USE_GFXTERM@"


set iperd_linux_console="@LINUX_CONSOLE@"
export iperd_linux_console


#
# attempt to load host specific defaults
set iperd_loaded_host_cfg="n";
if [ "x${net_default_mac}" != "x" ]; then

   # generate regex
   set iperd_mac_regex="^";
   for iperd_mac_count in "1" "2" "3" "4" "5"; do
      set iperd_mac_regex="${iperd_mac_regex}([[:xdigit:]])([[:xdigit:]]):";
   done
   set iperd_mac_regex="${iperd_mac_regex}([[:xdigit:]])([[:xdigit:]])\$";
   unset iperd_mac_count
   
   regexp --set  1:iperd_mac1  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  2:iperd_mac2  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  3:iperd_mac3  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  4:iperd_mac4  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  5:iperd_mac5  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  6:iperd_mac6  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  7:iperd_mac7  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  8:iperd_mac8  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set  9:iperd_mac9  "${iperd_mac_regex}" ${net_default_mac}
   regexp --set 10:iperd_mac10 "${iperd_mac_regex}" ${net_default_mac}
   regexp --set 11:iperd_mac11 "${iperd_mac_regex}" ${net_default_mac}
   regexp --set 12:iperd_mac12 "${iperd_mac_regex}" ${net_default_mac}
   unset iperd_mac_regex

   set iperd_mac0="";
   set iperd_mac1="${iperd_mac0}${iperd_mac1}";
   set iperd_mac2="${iperd_mac1}${iperd_mac2}";
   set iperd_mac3="${iperd_mac2}-${iperd_mac3}";
   set iperd_mac4="${iperd_mac3}${iperd_mac4}";
   set iperd_mac5="${iperd_mac4}-${iperd_mac5}";
   set iperd_mac6="${iperd_mac5}${iperd_mac6}";
   set iperd_mac7="${iperd_mac6}-${iperd_mac7}";
   set iperd_mac8="${iperd_mac7}${iperd_mac8}";
   set iperd_mac9="${iperd_mac8}-${iperd_mac9}";
   set iperd_mac10="${iperd_mac9}${iperd_mac10}";
   set iperd_mac11="${iperd_mac10}-${iperd_mac11}";
   set iperd_mac12="${iperd_mac11}${iperd_mac12}";

   for iperd_mac in ${iperd_mac12} ${iperd_mac11} ${iperd_mac10} ${iperd_mac9} ${iperd_mac8} ${iperd_mac7} ${iperd_mac6} ${iperd_mac5} ${iperd_mac4} ${iperd_mac3} ${iperd_mac2} ${iperd_mac1}; do
      if [ "x${iperd_loaded_host_cfg}" == "xn" ] ; then
         source (${root})/local/grub-${iperd_mac}.cfg
      fi
   done

   unset iperd_mac0
   unset iperd_mac1
   unset iperd_mac2
   unset iperd_mac3
   unset iperd_mac4
   unset iperd_mac5
   unset iperd_mac6
   unset iperd_mac7
   unset iperd_mac8
   unset iperd_mac9
   unset iperd_mac10
   unset iperd_mac11
   unset iperd_mac12
fi


#
# check PXE status and set initial network preferences
#
regexp --set iperd_tftp_ip "tftp,(.+)" ${root}
set iperd_network="n"
set iperd_network_card="any"
if [ ${iperd_tftp_ip} != "" ]; then
   set iperd_grub="(http,${iperd_tftp_ip})@IPERD_NET_PREFIX@"
   set iperd_url="http://${iperd_tftp_ip}@IPERD_NET_PREFIX@"
   set iperd_pxe="y"
else
   set iperd_grub="(${root})@IPERD_PREFIX@"
   set iperd_url="@IPERD_PREFIX@"
   set iperd_pxe="n"
   if [ "x${net_default_interface}" == "x" ]; then
      if [ ${grub_platform} == "efi" ]; then
         set iperd_network="y"
      fi
   fi
fi
export iperd_grub
export iperd_url
export iperd_pxe


#
# Prompt user to review setup options
#
if [ "x@GRUB_RUNTIME_NOTICE@" == "xy" ]; then
   echo ""
   echo ""
   iperd_notice
fi
if [ "x@IPERD_RUNTIME_SETUP@" == "xy" ]; then
   set iperd_continue="n"
   while [ ${iperd_continue} == "n" ]; do
      echo ""
      echo ""
      echo "      IP Engineering Rescue Disk @IPERD_VERSION@"
      echo ""
      echo "Review Configuration:"
      echo "   GNU GRUB Version:          @GRUB_VERSION@"
      echo "   Linux Console:             ${iperd_linux_console}"
      echo "   IPERD GRUB Prefix:         ${iperd_grub}"
      echo "   IPERD Boot URL:            ${iperd_url}"
      set iperd_str="${iperd_verbose}"
      iperd_boolean
      echo "   IPERD Verbose Messages:    ${iperd_str}"
      if [ "${iperd_verbose}" == "y" ]; then
         set iperd_str="${iperd_debug}"
         iperd_boolean
         echo "   IPERD Debug Messages:      ${iperd_str}"
      fi
      if [ "x${iperd_pxe}" == "xn" ]; then
         if [ ${grub_platform} == "efi" ]; then
            set iperd_str="${iperd_network}"
            iperd_boolean
            echo "   GRUB Initialize Network:   ${iperd_str}"
            if [ ${iperd_network} == "y" ]; then
               echo "   GRUB Network Interface:    ${iperd_network_card}"
            fi
         fi
      fi
      set iperd_str="${iperd_use_gfxterm}"
      iperd_boolean
      echo "   GRUB Graphics Terminal:    ${iperd_str}"
      echo "   GRUB Serial Term Type:     ${iperd_term_type}"
      echo "   GRUB Serial Term Geometry: ${iperd_term_geometry}"
      set iperd_str="${iperd_term_utf8}"
      iperd_boolean
      echo "   GRUB Serial Term UTF-8:    ${iperd_str}"
      echo ""

      set iperd_prompt_abort='y'
      set iperd_prompt_dflt=""
      set iperd_prompt_str="Is the above correct"
      iperd_boolean_prompt
      if [ "x${iperd_prompt_input}" == "xy" ]; then
         set iperd_continue="y"
      elif [ "x${iperd_prompt_input}" == "xa" ]; then
         echo "exiting IPERD/GRUB ..."
         exit
      fi

      if [ ${iperd_continue} == "n" ]; then

         # Linux Console
         set iperd_prompt_dflt="${iperd_linux_console}"
         set iperd_prompt_str="Linux Console"
         iperd_str_prompt
         set iperd_linux_console="${iperd_prompt_input}"

         # IPERD GRUB Prefix
         set iperd_prompt_dflt="${iperd_grub}"
         set iperd_prompt_str="IPERD GRUB Prefix"
         iperd_str_prompt
         set iperd_grub="${iperd_prompt_input}"

         # IPERD Boot URL
         set iperd_prompt_dflt="${iperd_url}"
         set iperd_prompt_str="IPERD Boot URL"
         iperd_str_prompt
         set iperd_url="${iperd_prompt_input}"

         # IPERD Verbose Messages
         set iperd_prompt_dflt="${iperd_verbose}"
         set iperd_prompt_str="IPERD Verbose Messages"
         iperd_boolean_prompt
         set iperd_verbose="${iperd_prompt_input}"

         # IPERD Debug Messages
         if [ "${iperd_verbose}" == "y" ]; then
            set iperd_prompt_dflt="${iperd_debug}"
            set iperd_prompt_str="IPERD Debug Messages"
            iperd_boolean_prompt
            set iperd_debug="${iperd_prompt_input}"
         fi

         if [ "x${iperd_pxe}" == "xn" ]; then
            if [ ${grub_platform} == "efi" ]; then

               # GRUB Initialize Network
               set iperd_prompt_dflt="${iperd_network}"
               set iperd_prompt_str="GRUB Initialize Network"
               iperd_boolean_prompt
               set iperd_network="${iperd_prompt_input}"

               # GRUB Network Interface
               if [ ${iperd_network} == "y" ]; then
                  set iperd_prompt_dflt="${iperd_network_card}"
                  set iperd_prompt_str="GRUB Network Interface (e.g. efinet0, any, etc)"
                  iperd_str_prompt
                  set iperd_network_card="${iperd_prompt_input}"
               fi

            fi
         fi

         # GRUB Graphics Terminal
         set iperd_prompt_dflt="${iperd_use_gfxterm}"
         set iperd_prompt_str="GRUB Graphics Terminal"
         iperd_boolean_prompt
         set iperd_use_gfxterm="${iperd_prompt_input}"

         # GRUB Serial Term Type
         set iperd_prompt_dflt="${iperd_term_type}"
         set iperd_prompt_str="GRUB Serial Term Type"
         iperd_str_prompt
         set iperd_term_type="${iperd_prompt_input}"

         # GRUB Serial Term Geometry
         set iperd_prompt_dflt="${iperd_term_geometry}"
         set iperd_prompt_str="GRUB Serial Term Geometry"
         iperd_str_prompt
         set iperd_term_geometry="${iperd_prompt_input}"

         # GRUB Serial Term UTF-8
         set iperd_prompt_dflt="${iperd_term_utf8}"
         set iperd_prompt_str="GRUB Serial Term UTF-8"
         iperd_boolean_prompt
         set iperd_term_utf8="${iperd_prompt_input}"

      fi
   done
   echo ""
   echo ""
else
   echo ""
   echo ""
   echo "      IP Engineering Rescue Disk @IPERD_VERSION@"
   echo ""
   echo ""
fi


#
# configure terminal
#
if [ ${iperd_term_utf8} == 'y' ]; then
   terminfo --utf8 -g ${iperd_term_geometry} serial ${iperd_term_type}
else
   terminfo --ascii -g ${iperd_term_geometry} serial ${iperd_term_type}
fi
if [ ${iperd_use_gfxterm} == "y" ]; then
   insmod png
   insmod jpeg
   insmod gfxterm
   insmod font
   loadfont /grub/themes/iperd/dejavu_10.pf2
   loadfont /grub/themes/iperd/dejavu_12.pf2
   loadfont /grub/themes/iperd/dejavu_14.pf2
   loadfont /grub/themes/iperd/dejavu_14_bold.pf2
   loadfont /grub/themes/iperd/dejavu_14_bolditalic.pf2
   loadfont /grub/themes/iperd/dejavu_16.pf2
   loadfont /grub/themes/iperd/dejavu_18.pf2
   set theme=/grub/themes/iperd/theme.txt
   set gfxmode=1024x768x32,auto
   set gfxterm_font="/grub/themes/iperd/dejavu_12.pf2"
   export theme
   export gfxmode
   export gfxterm_font
   terminal_output serial gfxterm
fi


#
# configure network using DHCP
#
if [ ${iperd_network} == "y" ]; then
   if [ "x${net_default_interface}" == "x" ]; then
      if [ ${grub_platform} == "efi" ]; then
         echo "configuring network using DHCP ..."
         echo ""
         echo ""
         if [ ${iperd_network_card} == "any" ]; then
            net_dhcp
         elif [ "x${iperd_network_card}" == "x" ]; then
            net_dhcp
         else
            net_dhcp "${iperd_network_card}"
         fi
         echo ""
         echo ""
         net_ls_addr
      fi   
   fi
fi


set pager=0
export pager


