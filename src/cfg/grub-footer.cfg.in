submenu 'Documentation ...' {
   menuentry "IPERD Copyright" {
      set pager=1
      export pager
      cat (${root})/COPYING.md
      iperd_continue "return to menu"
   }
   menuentry "IPERD Notice" {
      set pager=0
      export pager
      echo ""
      echo ""
      iperd_notice
      echo ""
      iperd_continue "return to menu"
   }
   menuentry "Software Versions" {
      set pager=0
      export pager
      cat (${root})/VERSION.md
      iperd_continue "return to menu"
   }
   menuentry "Networking Notes" {
      set pager=1
      export pager
      cat (${root})/doc/Networking.md
      iperd_continue "return to menu"
   }
}


submenu 'System Information ...' {
   menuentry "ACPI Hardware" {
      set pager=1
      export pager
      lsacpi
      iperd_continue "return to menu"
   }
   if [ ${grub_platform} != "efi" ]; then
      menuentry "APM Information" {
         set pager=0
         export pager
         lsapm
         iperd_continue "return to menu"
      }
   fi
   menuentry "Network Information" {
      set pager=0
      echo "Network Interfaces:"
      net_ls_cards
      echo ""
      echo "IP Addresses:"
      net_ls_addr
      echo ""
      echo "DNS:"
      net_ls_dns
      echo ""
      echo "Routes:"
      net_ls_routes
      iperd_continue "return to menu"
      set pager=1
   }
   menuentry "PCI Information" {
      set pager=1
      export pager
      lspci
      iperd_continue "return to menu"
   }
   menuentry "Terminal  Information" {
      set pager=0
      export pager
      terminfo
      iperd_continue "return to menu"
   }
   menuentry "USB Information" {
      set pager=1
      export pager
      usb
      iperd_continue "return to menu"
   }
   if [ ${grub_platform} != "efi" ]; then
      menuentry "VBE Information" {
         set pager=1
         export pager
         vbeinfo
         iperd_continue "return to menu"
      }
   fi
   menuentry "Video Information" {
      set pager=1
      export pager
      videoinfo
      iperd_continue "return to menu"
   }
   menuentry "Grub Variables" {
      set pager=1
      export pager
      set
      iperd_continue "return to menu"
   }
   menuentry "Loaded Grub Modules" {
      set pager=1
      export pager
      lsmod
      iperd_continue "return to menu"
   }
}


submenu 'System Options ...' {
   menuentry "Boot Next System Device" {
      echo "exiting grub ..."
      exit
   }
   menuentry "Reboot System" {
      echo "rebooting system ..."
      reboot
   }
   if [ ${grub_platform} == "efi" ]; then
      fwsetup --is-supported
      if [ $? -eq 0 ]; then
         menuentry "System Setup" {
            echo "rebooting system into setup ..."
            fwsetup
         }
      fi
   fi
   menuentry "Power Off System" {
      echo "halting system ..."
      halt
   }
}


# end of config
