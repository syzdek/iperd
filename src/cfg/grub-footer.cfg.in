submenu 'System Information ...' {
   menuentry "ACPI Hardware" {
      set pager=1
      export pager
      lsacpi
      echo ""
      echo "press [enter] to return to menu"
      read
   }
   if [ ${grub_platform} != "efi" ]; then
      menuentry "APM Information" {
         set pager=0
         export pager
         lsapm
         echo ""
         echo "press [enter] to return to menu"
         read
      }
   fi
   menuentry "Network Information" {
      set pager=0
      echo "Network Interfaces:"
      net_ls_cards
      echo ""
      echo "IP Addresses:"
      net_ls_addr
      echo ""
      echo "DNS:"
      net_ls_dns
      echo ""
      echo "Routes:"
      net_ls_routes
      echo ""
      echo "press [enter] to return to menu"
      read
      set pager=1
   }
   menuentry "PCI Information" {
      set pager=1
      export pager
      lspci
      echo ""
      echo "press [enter] to return to menu"
      read
   }
   menuentry "Terminal  Information" {
      set pager=0
      export pager
      terminfo
      echo ""
      echo "press [enter] to return to menu"
      read
   }
   menuentry "USB Information" {
      set pager=1
      export pager
      usb
      echo ""
      echo "press [enter] to return to menu"
      read
   }
   if [ ${grub_platform} != "efi" ]; then
      menuentry "VBE Information" {
         set pager=1
         export pager
         vbeinfo
         echo ""
         echo "press [enter] to return to menu"
         read
      }
   fi
   menuentry "Video Information" {
      set pager=1
      export pager
      videoinfo
      echo ""
      echo "press [enter] to return to menu"
      read
   }
   menuentry "Grub Variables" {
      set pager=1
      export pager
      set
      echo ""
      echo "press [enter] to return to menu"
      read
   }
   menuentry "Loaded Grub Modules" {
      set pager=1
      export pager
      lsmod
      echo ""
      echo "press [enter] to return to menu"
      read
   }
}


menuentry "Boot next device" {
   echo "exiting grub ..."
   exit
}
menuentry "Reboot System" {
   echo "rebooting system ..."
   reboot
}
if [ ${grub_platform} == "efi" ]; then
   fwsetup --is-supported
   if [ $? -eq 0 ]; then
      menuentry "System Setup" {
         echo "rebooting system into setup ..."
         fwsetup
      }
   fi
fi
menuentry "Power Off System" {
   echo "halting system ..."
   halt
}


# end of config
